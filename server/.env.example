# ==============================================================================
# SketchVLM Mobile Video Server - Environment Configuration
# Copy this file to .env and fill in your API credentials.
# ==============================================================================

# OpenRouter API Key (Gateway for Qwen 2.5-VL / Qwen 3.8, Claude, GPT-4o, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (Optional, for direct GPT-4o inference)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional, for direct Claude inference)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
